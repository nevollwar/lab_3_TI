<Window x:Class="WpEngine.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WpEngine.UI.Views"
        xmlns:payViews="clr-namespace:WpEngine.UI.Views.Payment"
        mc:Ignorable="d"
        Title="Формальная верификация программ — ЛР-1 · ЛР-2 · ЛР-3"
        Height="880" Width="1340"
        MinHeight="680" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="220"
        ToolTipService.BetweenShowDelay="100"
        ToolTipService.ShowDuration="60000"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Единая верхняя навигационная панель: ЛР-1 → ЛР-2 → ЛР-3 -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBase}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Бренд / Заголовок комплекса -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Комплекс формальной верификации"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   FontSize="14.5"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Border Background="{StaticResource BgPrimaryTonal}"
                                CornerRadius="8"
                                Padding="7,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="ТвГТУ · Б.ПИН.ИИ.25.16"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#041E49" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Банковское ядро: Контракты (ЛР-1) → wp (ЛР-2) → Циклы (ЛР-3)"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <!-- Переключатель лабораторных работ -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BgTonal}"
                        BorderBrush="{StaticResource BorderBase}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLab1"
                                     Content="ЛР-1 · Платёжный модуль"
                                     GroupName="LabNavigation"
                                     Style="{StaticResource LabNavTab}"
                                     FontSize="12.5"
                                     Padding="12,7"
                                     IsChecked="True"
                                     Checked="LabTab_Checked"
                                     Tag="0"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="TabLab2"
                                     Content="ЛР-2 · Калькулятор wp"
                                     GroupName="LabNavigation"
                                     Style="{StaticResource LabNavTab}"
                                     FontSize="12.5"
                                     Padding="12,7"
                                     Checked="LabTab_Checked"
                                     Tag="1"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="TabLab3"
                                     Content="ЛР-3 · Верификатор циклов"
                                     GroupName="LabNavigation"
                                     Style="{StaticResource LabNavTab}"
                                     FontSize="12.5"
                                     Padding="12,7"
                                     Checked="LabTab_Checked"
                                     Tag="2" />
                    </StackPanel>
                </Border>

                <!-- Горячие клавиши -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgRecessed}"
                        BorderBrush="{StaticResource BorderBase}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Быстрое переключение разделов: Ctrl+1, Ctrl+2, Ctrl+3">
                    <TextBlock Text="Ctrl+1/2/3"
                               FontFamily="{StaticResource CodeFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}" />
                </Border>
            </Grid>
        </Border>

        <!-- Контент выбранной лабораторной работы (состояние всех вкладок сохраняется в памяти) -->
        <Grid Grid.Row="1">
            <payViews:PaymentModuleView x:Name="PaymentView" Visibility="Visible" />
            <views:WpCalculatorView x:Name="WpView" Visibility="Collapsed" />
            <views:LoopsView x:Name="LoopsViewControl" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
