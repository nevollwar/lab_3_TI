<UserControl x:Class="WpEngine.UI.Views.LoopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpEngine.UI.ViewModels"
             xmlns:conv="clr-namespace:WpEngine.UI.Converters"
             xmlns:math="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1240"
             Background="{StaticResource BgCanvas}"
             FontFamily="{StaticResource MainFont}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:LoopPanelViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter   x:Key="InvBoolToVis" Invert="True" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:StringToVisibilityConverter x:Key="InvStringToVis" Invert="True" />
        <conv:BoolToColorBrushConverter   x:Key="BoolToGreenRed" />
        <conv:BoolToStringConverter       x:Key="BoolToCheckCross"
                                          TrueText="✓ Истинен" FalseText="✗ Нарушен" />
        <conv:BoolToStringConverter       x:Key="BoolToValidText"
                                          TrueText="Все условия ок" FalseText="Есть нарушения" />
        <conv:BoolToStringConverter       x:Key="BoolToYesNo"
                                          TrueText="✓" FalseText="✗" />

        <!-- Компактный Expander для однострочных карточек условий корректности -->
        <Style x:Key="CompactConditionExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Grid.Column="0"
                                                  Data="M 1,0 L 6,4 L 1,8 Z"
                                                  Fill="{StaticResource TextMuted}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                                            <ContentPresenter Grid.Column="1"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0,1 L 8,1 L 4,6 Z" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrandPrimary}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrandPrimary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              Margin="16,8,0,2" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель инструментов -->
        <Grid Grid.Row="0" Margin="22,14,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Column="0"
                       Text="Проверка циклов · Транзакции банка"
                       FontFamily="{StaticResource DisplayFont}"
                       FontWeight="SemiBold"
                       FontSize="16.5"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <!-- Выбор режима, быстрые кнопки и бейдж Post -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Режим:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding SelectedMode}"
                          DisplayMemberPath="DisplayName"
                          Width="220"
                          Padding="10,6"
                          VerticalContentAlignment="Center"
                          FontSize="13"
                          Margin="0,0,10,0" />

                <Button Content="Шаг"
                        Style="{StaticResource TonalButton}"
                        Command="{Binding StepCommand}"
                        Padding="14,7"
                        FontSize="13"
                        Margin="0,0,6,0" />
                <Button Content="Пуск"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}"
                        Padding="16,7"
                        FontSize="13"
                        Margin="0,0,6,0" />
                <Button Content="Сброс"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetCommand}"
                        Padding="14,7"
                        FontSize="13"
                        Margin="0,0,6,0" />
                <Button Content="? Справка"
                        Style="{StaticResource SecondaryButton}"
                        Click="HelpButton_Click"
                        Padding="12,7"
                        FontSize="13"
                        ToolTip="Открыть подробную справку по ЛР-3: режимы, инварианты, индикаторы и правила корректности" />

                <Border Background="#CEEAD6"
                        BorderBrush="#A8DAB5"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding PostHeld, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✓ Post выполнен"
                               Foreground="#137333"
                               FontWeight="SemiBold"
                               FontSize="12.5" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная двухколоночная область -->
        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.25*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КАРТОЧКА: Данные, массив, инвариант и вариант-функция -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SurfaceShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22,20">
                    <StackPanel>

                        <!-- 1. Панель «Журнал транзакций» -->
                        <Border Background="{StaticResource BgTonal}"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Журнал транзакций"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold"
                                           FontSize="14.5"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="{Binding ScenarioContext}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="17"
                                           Margin="0,0,0,10" />

                                <!-- Строка A: параметры генератора с понятными подписями и подсказками -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"
                                                ToolTip="n — сколько транзакций сгенерировать в журнале (от 1 до 50)">
                                        <TextBlock Text="Операций (n):" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding N, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="44" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"
                                                ToolTip="Min — минимальная сумма случайной транзакции в ₽">
                                        <TextBlock Text="От (₽):" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Min}"
                                                 Width="56" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"
                                                ToolTip="Max — максимальная сумма случайной транзакции в ₽">
                                        <TextBlock Text="До (₽):" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Max}"
                                                 Width="56" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,4"
                                                Visibility="{Binding IsThresholdVisible, Converter={StaticResource BoolToVis}}"
                                                ToolTip="T — порог контроля: считаются все транзакции строго больше T ₽">
                                        <TextBlock Text="Порог T (₽):" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Threshold}"
                                                 Width="58" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Строка B: кнопки генерации и загрузки из ЛР-1 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Сгенерировать"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding GenerateCommand}"
                                            Padding="14,5"
                                            FontSize="12.5" />

                                    <Button Content="{Binding DbTransactionsBadge}"
                                            Style="{StaticResource TonalButton}"
                                            Command="{Binding LoadFromLab1Command}"
                                            Padding="14,5"
                                            FontSize="12.5"
                                            Margin="8,0,0,0"
                                            ToolTip="Загрузить реальные суммы транзакций из базы payment.db (ЛР-1)" />
                                </StackPanel>

                                <!-- Интерактивные ячейки массива с индексом a[i] и значением -->
                                <ItemsControl ItemsSource="{Binding Array}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinWidth="64"
                                                    Margin="0,0,6,6"
                                                    Padding="4,5"
                                                    CornerRadius="8"
                                                    ToolTip="Сумма транзакции a[i] в ₽. Кликните по числу, чтобы изменить его вручную.">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBase}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#D3E3FD" />
                                                                <Setter Property="BorderBrush" Value="#0B57D0" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Index, StringFormat=a[{0}]}"
                                                               FontFamily="{StaticResource CodeFont}"
                                                               FontSize="10.5"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                             Width="58"
                                                             Padding="2,3"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13"
                                                             FontWeight="SemiBold"
                                                             FontFamily="{StaticResource CodeFont}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Текущее состояние в виде понятных плашек-пилюль -->
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,8,4"
                                            ToolTip="j — номер текущей проверяемой транзакции a[j] (от 0 до n)">
                                        <TextBlock FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="Индекс j = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding CurrentIndex, Mode=OneWay}"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrandPrimary}" />
                                        </TextBlock>
                                    </Border>

                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,8,4"
                                            ToolTip="res — накопленный результат по уже проверенным транзакциям a[0..j-1]">
                                        <TextBlock FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="Итог res = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding Result, Mode=OneWay}"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrandPrimary}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding ResultUnit, Mode=OneWay}"
                                                 Foreground="{StaticResource TextSecondary}" />
                                        </TextBlock>
                                    </Border>

                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,0,4"
                                            ToolTip="Вариант-функция t = n − j: сколько транзакций осталось обработать до завершения цикла">
                                        <TextBlock FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="Осталось t = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding VariantT, Mode=OneWay}"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrandPrimary}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Блок «Инвариант и вариант-функция» -->
                        <StackPanel>
                            <TextBlock Text="Инвариант и вариант-функция"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="14.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Инвариант (Inv):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Border Background="{StaticResource BgRecessed}"
                                    BorderBrush="{StaticResource BorderBase}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6">
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <math:FormulaControl Formula="{Binding InvariantLatex}"
                                                         Scale="15"
                                                         Foreground="#0B57D0"
                                                         SnapsToDevicePixels="True"
                                                         UseLayoutRounding="True" />
                                </Viewbox>
                            </Border>

                            <TextBlock Text="{Binding InvariantWords}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,12" />

                            <!-- Карточки «До шага» и «После шага» (видны всегда: до шага зелёный, после всех шагов красный) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="До шага"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,4" />
                                        <Border Height="6"
                                                CornerRadius="3"
                                                Background="{Binding InvariantBeforeStep, Converter={StaticResource BoolToGreenRed}}" />
                                        <TextBlock Text="{Binding InvariantBeforeStep, Converter={StaticResource BoolToCheckCross}}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding InvariantBeforeStep, Converter={StaticResource BoolToGreenRed}}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="После шага"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,4" />
                                        <Border Height="6"
                                                CornerRadius="3"
                                                Background="{Binding InvariantAfterIsGreen, Converter={StaticResource BoolToGreenRed}}" />
                                        <TextBlock Text="{Binding InvariantAfterStatusText}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding InvariantAfterIsGreen, Converter={StaticResource BoolToGreenRed}}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Вариант-функция + прогресс-бар -->
                            <TextBlock Text="Вариант-функция (t):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,7">
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <math:FormulaControl Formula="{Binding VariantLatex}"
                                                             Scale="15"
                                                             Foreground="#0B57D0"
                                                             SnapsToDevicePixels="True"
                                                             UseLayoutRounding="True" />
                                    </Viewbox>
                                </Border>
                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Background="{StaticResource BgTonal}"
                                        CornerRadius="8"
                                        Padding="12,7">
                                    <TextBlock Text="{Binding VariantT, StringFormat=t \= {0}, Mode=OneWay}"
                                               FontFamily="{StaticResource CodeFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandPrimary}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <ProgressBar Value="{Binding VariantT, Mode=OneWay}"
                                         Maximum="{Binding VariantMax, Mode=OneWay}"
                                         Minimum="0"
                                         Height="8"
                                         Margin="0,2,0,6"
                                         Background="#E8EAED"
                                         Foreground="#0B57D0" />

                            <TextBlock Text="{Binding VariantWords}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ПРАВАЯ КАРТОЧКА: Проверка сохранения (wp) и история шагов -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SurfaceShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22,20">
                    <StackPanel>

                        <!-- 1. Блок «Проверка сохранения (wp)» -->
                        <StackPanel Visibility="{Binding VerificationDone, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Проверка сохранения (wp)"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold"
                                           FontSize="14.5"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Background="{Binding AllConditionsValid, Converter={StaticResource BoolToGreenRed}}">
                                    <TextBlock Text="{Binding AllConditionsValid,
                                                             Converter={StaticResource BoolToValidText},
                                                             ConverterParameter='Все условия ок|Есть нарушения'}"
                                               Foreground="White"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <TextBlock Text="Условие сохранения (Inv ∧ B) ⇒ wp(S, Inv):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Border Background="{StaticResource BgRecessed}"
                                    BorderBrush="{StaticResource BorderBase}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6">
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <math:FormulaControl Formula="{Binding WpPreservationLatex}"
                                                         Scale="14.5"
                                                         Foreground="#0B57D0"
                                                         SnapsToDevicePixels="True"
                                                         UseLayoutRounding="True" />
                                </Viewbox>
                            </Border>

                            <Expander Header="Разбор формулы словами"
                                      IsExpanded="False"
                                      FontSize="12.5"
                                      Foreground="{StaticResource TextSecondary}"
                                      Margin="0,0,0,10">
                                <Border Background="{StaticResource BgTonal}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,6,0,0">
                                    <TextBlock Text="{Binding WpPreservationExplanation}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               LineHeight="18" />
                                </Border>
                            </Expander>

                            <TextBlock Text="Условия тотальной корректности (4 правила + Def):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Padding="10,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FFF8" />
                                                    <Setter Property="BorderBrush" Value="#A8DAB5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="Background" Value="#FFF8F8" />
                                                            <Setter Property="BorderBrush" Value="#F28B82" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Expander Style="{StaticResource CompactConditionExpander}"
                                                      IsExpanded="{Binding IsExpanded}">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center" />
                                                        <Viewbox Grid.Column="1"
                                                                 StretchDirection="DownOnly"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Margin="8,0,8,0"
                                                                 ToolTip="{Binding Formula}">
                                                            <math:FormulaControl Formula="{Binding FormulaLatex}"
                                                                                 Scale="13"
                                                                                 Foreground="#0B57D0"
                                                                                 SnapsToDevicePixels="True"
                                                                                 UseLayoutRounding="True" />
                                                        </Viewbox>
                                                        <Border Grid.Column="2"
                                                                CornerRadius="6"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding IsValid, Converter={StaticResource BoolToGreenRed}}">
                                                            <TextBlock Text="{Binding IsValid, Converter={StaticResource BoolToYesNo}}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>

                                                <StackPanel>
                                                    <TextBlock Text="Развёрнутая формула:"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,0,0,3" />
                                                    <Border Background="{StaticResource BgPanel}"
                                                            BorderBrush="{StaticResource BorderBase}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,6"
                                                            Margin="0,0,0,6">
                                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <math:FormulaControl Formula="{Binding ExpandedFormulaLatex}"
                                                                                 Scale="13.5"
                                                                                 Foreground="#0B57D0"
                                                                                 SnapsToDevicePixels="True"
                                                                                 UseLayoutRounding="True" />
                                                        </Viewbox>
                                                    </Border>

                                                    <TextBlock Text="Пояснение:"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding HumanExplanation}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="17"
                                                               Margin="0,0,0,6" />

                                                    <TextBlock Text="Доказательство:"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding ProofSummary}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="17" />
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 2. Блок «История шагов и лог варианта t» -->
                        <StackPanel>
                            <TextBlock Text="История шагов и лог варианта t"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="14.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,8" />

                            <!-- Подсказка, пока не сделано ни одного шага -->
                            <Border Background="{StaticResource BgTonal}"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Visibility="{Binding HasSteppedOnce, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="Нажмите «Шаг» или «Пуск», чтобы проследить выполнение цикла, проверку инварианта Inv и убывание варианта t."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="18" />
                            </Border>

                            <!-- Таблица шагов и лог варианта -->
                            <StackPanel Visibility="{Binding HasSteppedOnce, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Шапка таблицы -->
                                        <Border Background="{StaticResource BgTonal}"
                                                CornerRadius="10,10,0,0"
                                                Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="j"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="res"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="t"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="Inv до"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="Inv после"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="Post"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Строки таблицы -->
                                        <ItemsControl ItemsSource="{Binding StepHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10,5"
                                                            BorderThickness="0,1,0,0"
                                                            BorderBrush="{StaticResource BorderBase}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                                        <Setter Property="Background" Value="#FFF3F3" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="68" />
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding StepNumber}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding J}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Res}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Variant}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />

                                                            <Border Grid.Column="4"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{Binding InvariantBefore, Converter={StaticResource BoolToGreenRed}}">
                                                                <TextBlock Text="{Binding InvariantBefore, Converter={StaticResource BoolToYesNo}}"
                                                                           FontSize="11"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Border Grid.Column="5"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{Binding InvariantAfter, Converter={StaticResource BoolToGreenRed}}">
                                                                <TextBlock Text="{Binding InvariantAfter, Converter={StaticResource BoolToYesNo}}"
                                                                           FontSize="11"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Border Grid.Column="6"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#E8EAED" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PostHeld}" Value="True">
                                                                                <Setter Property="Background" Value="#34A853" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="—" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PostHeld}" Value="True">
                                                                                    <Setter Property="Text" Value="✓" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Лог убывания варианта t"
                                          IsExpanded="False"
                                          FontSize="12.5"
                                          Foreground="{StaticResource TextSecondary}">
                                    <Border Background="{StaticResource BgRecessed}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding VariantLog}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="{StaticResource CodeFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrandPrimary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Нижняя строка состояния -->
        <Grid Grid.Row="2" Margin="24,0,24,4">
            <TextBlock Text="{Binding StatusLine}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusLine, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="Готово к проверке. Нажмите «Шаг» или «Пуск» либо загрузите транзакции из ЛР-1."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusLine, Converter={StaticResource InvStringToVis}}" />

            <TextBlock Text="Кликните по ячейке a[i], чтобы изменить сумму (₽) • Подробности в «? Справка»"
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
