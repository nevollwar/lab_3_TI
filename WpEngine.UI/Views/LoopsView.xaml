<UserControl x:Class="WpEngine.UI.Views.LoopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpEngine.UI.ViewModels"
             xmlns:conv="clr-namespace:WpEngine.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1240"
             Background="{StaticResource BgCanvas}"
             FontFamily="{StaticResource MainFont}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:LoopPanelViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter   x:Key="InvBoolToVis" Invert="True" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:StringToVisibilityConverter x:Key="InvStringToVis" Invert="True" />
        <conv:BoolToColorBrushConverter   x:Key="BoolToGreenRed" />
        <conv:BoolToStringConverter       x:Key="BoolToCheckCross"
                                          TrueText="✓ Истинен" FalseText="✗ Нарушен" />
        <conv:BoolToStringConverter       x:Key="BoolToValidText"
                                          TrueText="Все условия ок" FalseText="Есть нарушения" />
        <conv:BoolToStringConverter       x:Key="BoolToYesNo"
                                          TrueText="✓" FalseText="✗" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель инструментов -->
        <Grid Grid.Row="0" Margin="22,14,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Заголовок и подсказка -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Верификатор циклов (инварианты, вариант, wp)"
                           FontFamily="{StaticResource DisplayFont}"
                           FontWeight="SemiBold"
                           FontSize="16.5"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" />

                <Border Style="{StaticResource HintBadge}" Margin="10,0,0,0">
                    <TextBlock Text="(Inv ∧ B) ⇒ wp(S, Inv) ?"
                               FontFamily="{StaticResource CodeFont}"
                               FontWeight="SemiBold"
                               FontSize="11.5"
                               Foreground="{StaticResource BrandPrimary}" />
                    <Border.ToolTip>
                        <ToolTip Placement="Bottom" VerticalOffset="6">
                            <StackPanel>
                                <TextBlock Text="Тотальная корректность цикла"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Для доказательства корректности цикла проверяются инициализация инварианта Inv, сохранение Inv после тела цикла через wp(S, Inv), достижение постусловия при выходе (Inv ∧ ¬B ⇒ Post), а также ограниченность и строгое убывание вариант-функции t."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="17" />
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                </Border>
            </StackPanel>

            <!-- Выбор режима, быстрые кнопки и бейдж Post -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Режим:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding SelectedMode}"
                          DisplayMemberPath="DisplayName"
                          Width="185"
                          Padding="10,6"
                          VerticalContentAlignment="Center"
                          FontSize="13"
                          Margin="0,0,12,0" />

                <Button Content="Шаг"
                        Style="{StaticResource TonalButton}"
                        Command="{Binding StepCommand}"
                        Padding="16,7"
                        FontSize="13"
                        Margin="0,0,8,0" />
                <Button Content="Пуск"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}"
                        Padding="18,7"
                        FontSize="13"
                        Margin="0,0,8,0" />
                <Button Content="Сброс"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetCommand}"
                        Padding="16,7"
                        FontSize="13" />

                <Border Background="#CEEAD6"
                        BorderBrush="#A8DAB5"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding PostHeld, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✓ Post выполнен"
                               Foreground="#137333"
                               FontWeight="SemiBold"
                               FontSize="12.5" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная двухколоночная область -->
        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.25*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КАРТОЧКА: Данные, массив, инвариант и вариант-функция -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SurfaceShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22,20">
                    <StackPanel>

                        <!-- 1. Панель «Данные и массив» -->
                        <Border Background="{StaticResource BgTonal}"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Данные и массив"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontWeight="SemiBold"
                                               FontSize="14.5"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource HintBadge}" HorizontalAlignment="Right">
                                        <TextBlock Text="? редактирование"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource BrandPrimary}" />
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="Любое значение a[i] можно изменить вручную прямо в ячейке; после выхода из поля цикл автоматически обновится."
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17" />
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </Grid>

                                <!-- Параметры генератора -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                        <TextBlock Text="n:" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding N, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="46" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                        <TextBlock Text="Min:" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Min}"
                                                 Width="48" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                        <TextBlock Text="Max:" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Max}"
                                                 Width="48" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                        <TextBlock Text="T (порог):" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Text="{Binding Threshold}"
                                                 Width="48" Padding="6,5" FontSize="13"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    <Button Content="Сгенерировать"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding GenerateCommand}"
                                            Padding="14,5"
                                            FontSize="12.5"
                                            Margin="0,0,0,6" />
                                </WrapPanel>

                                <!-- Интерактивные ячейки массива с индексом a[i] и значением -->
                                <ItemsControl ItemsSource="{Binding Array}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinWidth="50"
                                                    Margin="0,0,6,6"
                                                    Padding="4,5"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBase}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#D3E3FD" />
                                                                <Setter Property="BorderBrush" Value="#0B57D0" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Index, StringFormat=a[{0}]}"
                                                               FontFamily="{StaticResource CodeFont}"
                                                               FontSize="10.5"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                             Width="44"
                                                             Padding="2,3"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13"
                                                             FontWeight="SemiBold"
                                                             FontFamily="{StaticResource CodeFont}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Текущее состояние в виде плашек-пилюль -->
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,8,0">
                                        <TextBlock FontFamily="{StaticResource CodeFont}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="j = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding CurrentIndex, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" />
                                        </TextBlock>
                                    </Border>

                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,8,0">
                                        <TextBlock FontFamily="{StaticResource CodeFont}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="res = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding Result, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" />
                                        </TextBlock>
                                    </Border>

                                    <Border Background="{StaticResource BgPanel}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4">
                                        <TextBlock FontFamily="{StaticResource CodeFont}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}">
                                            <Run Text="t = " Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding VariantT, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Блок «Инвариант и вариант-функция» -->
                        <StackPanel>
                            <TextBlock Text="Инвариант и вариант-функция"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="14.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Инвариант (Inv):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Border Background="{StaticResource BgRecessed}"
                                    BorderBrush="{StaticResource BorderBase}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6">
                                <TextBlock Text="{Binding InvariantFormula}"
                                           FontFamily="{StaticResource CodeFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource BrandPrimary}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding InvariantWords}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,12" />

                            <!-- Карточки «До шага» и «После шага» -->
                            <Grid Visibility="{Binding HasSteppedOnce, Converter={StaticResource BoolToVis}}"
                                  Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="До шага"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,4" />
                                        <Border Height="6"
                                                CornerRadius="3"
                                                Background="{Binding InvariantBeforeStep, Converter={StaticResource BoolToGreenRed}}" />
                                        <TextBlock Text="{Binding InvariantBeforeStep, Converter={StaticResource BoolToCheckCross}}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding InvariantBeforeStep, Converter={StaticResource BoolToGreenRed}}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="После шага"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,4" />
                                        <Border Height="6"
                                                CornerRadius="3"
                                                Background="{Binding InvariantAfterStep, Converter={StaticResource BoolToGreenRed}}" />
                                        <TextBlock Text="{Binding InvariantAfterStep, Converter={StaticResource BoolToCheckCross}}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding InvariantAfterStep, Converter={StaticResource BoolToGreenRed}}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Вариант-функция + прогресс-бар -->
                            <TextBlock Text="Вариант-функция (t):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource BgRecessed}"
                                        BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,7">
                                    <TextBlock Text="{Binding VariantFormula}"
                                               FontFamily="{StaticResource CodeFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandPrimary}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Background="{StaticResource BgTonal}"
                                        CornerRadius="8"
                                        Padding="12,7">
                                    <TextBlock Text="{Binding VariantT, StringFormat=t \= {0}, Mode=OneWay}"
                                               FontFamily="{StaticResource CodeFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandPrimary}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <ProgressBar Value="{Binding VariantT, Mode=OneWay}"
                                         Maximum="{Binding VariantMax, Mode=OneWay}"
                                         Minimum="0"
                                         Height="8"
                                         Margin="0,2,0,6"
                                         Background="#E8EAED"
                                         Foreground="#0B57D0" />

                            <TextBlock Text="{Binding VariantWords}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ПРАВАЯ КАРТОЧКА: Проверка сохранения (wp) и история шагов -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SurfaceShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22,20">
                    <StackPanel>

                        <!-- 1. Блок «Проверка сохранения (wp)» -->
                        <StackPanel Visibility="{Binding VerificationDone, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,18">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Проверка сохранения (wp)"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold"
                                           FontSize="14.5"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Background="{Binding AllConditionsValid, Converter={StaticResource BoolToGreenRed}}">
                                    <TextBlock Text="{Binding AllConditionsValid,
                                                             Converter={StaticResource BoolToValidText},
                                                             ConverterParameter='Все условия ок|Есть нарушения'}"
                                               Foreground="White"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding VerificationSummary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AllConditionsValid, Converter={StaticResource BoolToGreenRed}}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Условие сохранения (Inv ∧ B) ⇒ wp(S, Inv):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Border Background="{StaticResource BgRecessed}"
                                    BorderBrush="{StaticResource BorderBase}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding WpPreservationFormula}"
                                           FontFamily="{StaticResource CodeFont}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource BrandPrimary}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Expander Header="Разбор формулы словами"
                                      IsExpanded="False"
                                      FontSize="12.5"
                                      Foreground="{StaticResource TextSecondary}"
                                      Margin="0,0,0,12">
                                <Border Background="{StaticResource BgTonal}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,6,0,0">
                                    <TextBlock Text="{Binding WpPreservationExplanation}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               LineHeight="18" />
                                </Border>
                            </Expander>

                            <TextBlock Text="Условия тотальной корректности (4 правила):"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                Padding="12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FFF8" />
                                                    <Setter Property="BorderBrush" Value="#34A853" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="Background" Value="#FFF8F8" />
                                                            <Setter Property="BorderBrush" Value="#D93025" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center" />
                                                    <Border HorizontalAlignment="Right"
                                                            CornerRadius="6"
                                                            Padding="8,2"
                                                            Background="{Binding IsValid, Converter={StaticResource BoolToGreenRed}}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <Border Background="#F1F3F4"
                                                        CornerRadius="6"
                                                        Padding="8,5"
                                                        Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Formula}"
                                                               FontFamily="{StaticResource CodeFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrandPrimary}"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <Expander IsExpanded="{Binding IsExpanded}"
                                                          Header="Подробнее"
                                                          FontSize="12"
                                                          Foreground="{StaticResource TextSecondary}"
                                                          Margin="0,6,0,0">
                                                    <StackPanel Margin="0,6,0,0">
                                                        <TextBlock Text="Развёрнутая формула:"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Margin="0,0,0,3" />
                                                        <Border Background="{StaticResource BgPanel}"
                                                                BorderBrush="{StaticResource BorderBase}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding ExpandedFormula}"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextWrapping="Wrap" />
                                                        </Border>

                                                        <TextBlock Text="Пояснение:"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding HumanExplanation}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="17"
                                                                   Margin="0,0,0,6" />

                                                        <TextBlock Text="Доказательство:"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding ProofSummary}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="17" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 2. Блок «История шагов и лог варианта t» -->
                        <StackPanel>
                            <TextBlock Text="История шагов и лог варианта t"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="14.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,8" />

                            <!-- Подсказка, пока не сделано ни одного шага -->
                            <Border Background="{StaticResource BgTonal}"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Visibility="{Binding HasSteppedOnce, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="Нажмите «Шаг» или «Пуск» на верхней панели, чтобы запустить пошаговое исполнение цикла и отследить инвариант и вариант-функцию t."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="18" />
                            </Border>

                            <!-- Таблица шагов и лог варианта -->
                            <StackPanel Visibility="{Binding HasSteppedOnce, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="{StaticResource BorderBase}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Шапка таблицы -->
                                        <Border Background="{StaticResource BgTonal}"
                                                CornerRadius="10,10,0,0"
                                                Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="j"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="res"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="t"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="Inv до"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="Inv после"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="Post"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Строки таблицы -->
                                        <ItemsControl ItemsSource="{Binding StepHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10,5"
                                                            BorderThickness="0,1,0,0"
                                                            BorderBrush="{StaticResource BorderBase}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                                        <Setter Property="Background" Value="#FFF3F3" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding StepNumber}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding J}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Res}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Variant}"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource CodeFont}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />

                                                            <Border Grid.Column="4"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{Binding InvariantBefore, Converter={StaticResource BoolToGreenRed}}">
                                                                <TextBlock Text="{Binding InvariantBefore, Converter={StaticResource BoolToYesNo}}"
                                                                           FontSize="11"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Border Grid.Column="5"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{Binding InvariantAfter, Converter={StaticResource BoolToGreenRed}}">
                                                                <TextBlock Text="{Binding InvariantAfter, Converter={StaticResource BoolToYesNo}}"
                                                                           FontSize="11"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Border Grid.Column="6"
                                                                    CornerRadius="5"
                                                                    Margin="4,1"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#E8EAED" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PostHeld}" Value="True">
                                                                                <Setter Property="Background" Value="#34A853" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="—" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PostHeld}" Value="True">
                                                                                    <Setter Property="Text" Value="✓" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Лог убывания варианта t"
                                          IsExpanded="False"
                                          FontSize="12.5"
                                          Foreground="{StaticResource TextSecondary}">
                                    <Border Background="{StaticResource BgRecessed}"
                                            BorderBrush="{StaticResource BorderBase}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding VariantLog}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="{StaticResource CodeFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrandPrimary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Нижняя строка состояния -->
        <Grid Grid.Row="2" Margin="24,0,24,4">
            <TextBlock Text="{Binding StatusLine}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusLine, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="Готово к верификации. Нажмите «Шаг» или «Пуск», либо отредактируйте элементы массива."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusLine, Converter={StaticResource InvStringToVis}}" />

            <TextBlock Text="Наведите на «?» для справки • Кликните по ячейке a[i] для изменения"
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
