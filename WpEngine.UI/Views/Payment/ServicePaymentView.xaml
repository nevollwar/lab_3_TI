<UserControl x:Class="WpEngine.UI.Views.Payment.ServicePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="880"
             FontFamily="{StaticResource MainFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="310" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.25*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Левая карточка: параметры оплаты услуги -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBase}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                Effect="{StaticResource SurfaceShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Параметры оплаты"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="15.5"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Счёт списания"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource BgRecessed}"
                              BorderBrush="{StaticResource BorderInput}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13"
                              Padding="10,7"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Услуга"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Services}"
                              SelectedItem="{Binding SelectedService}"
                              Background="{StaticResource BgRecessed}"
                              BorderBrush="{StaticResource BorderInput}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13"
                              Padding="10,7"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Сумма платежа (₽)"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="14"
                             Margin="0,0,0,12" />

                    <!-- Баннер предварительного расчёта комиссии -->
                    <Border Background="{StaticResource BgPrimaryTonalLight}"
                            BorderBrush="{StaticResource BgPrimaryTonal}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Предварительный расчёт комиссии"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandPrimary}"
                                       Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CommissionPreviewText}"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Content="Оплатить услугу"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExecuteCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="20,10"
                            Margin="0,0,0,18" />

                    <Border Background="{StaticResource BgTonal}"
                            BorderBrush="{StaticResource BorderBase}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Квитанция операции"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       Foreground="{StaticResource BrandPrimary}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding LastResultText}"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая колонка: счета + таблица тарифов комиссий -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource SurfaceShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Доступные счета"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="15.5"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12" />

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Accounts}"
                              BorderBrush="{StaticResource BorderBase}"
                              BorderThickness="1"
                              Background="{StaticResource BgRecessed}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="№ счёта" Width="110" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Владелец" Width="150" DisplayMemberBinding="{Binding Owner}" />
                                <GridViewColumn Header="Баланс" Width="125" DisplayMemberBinding="{Binding Balance, StringFormat={}{0:N2} ₽}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Карточка тарифов комиссии -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,16"
                    Effect="{StaticResource SurfaceShadow}">
                <StackPanel>
                    <TextBlock Text="Тарифы комиссии за оплату услуг"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="14.5"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Интернет" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1,0%" FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Мобильная связь" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="2,0%" FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Коммунальные услуги" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="1,5%" FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Телевидение" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="1,0%" FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,3" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
