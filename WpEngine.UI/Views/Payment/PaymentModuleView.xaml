<UserControl x:Class="WpEngine.UI.Views.Payment.PaymentModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:payVm="clr-namespace:WpEngine.UI.ViewModels.Payment"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=payVm:PaymentModuleViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="{StaticResource BgCanvas}"
             FontFamily="{StaticResource MainFont}">

    <Grid Margin="20,12,20,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая боковая панель навигации по операциям ЛР-1 -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBase}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,16"
                Effect="{StaticResource SurfaceShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ОПЕРАЦИИ МОДУЛЯ (ЛР-1)"
                           FontFamily="{StaticResource DisplayFont}"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           Foreground="{StaticResource TextMuted}"
                           Margin="8,2,8,12" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Operations}"
                         SelectedItem="{Binding SelectedOperation}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FocusVisualStyle="{x:Null}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="pill"
                                                Background="Transparent"
                                                CornerRadius="12"
                                                Padding="12,11"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="{StaticResource BgTonal}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="{StaticResource BgPrimaryTonal}" />
                                                <Setter Property="Foreground" Value="#041E49" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13.5"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Нижняя информационная карточка -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgTonal}"
                        BorderBrush="{StaticResource BorderBase}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,11"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Контрактное программирование"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource BrandPrimary}"
                                   Margin="0,0,0,5" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="16">
                            Предусловия проверяются через <Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">Guard.Requires</Run>, постусловия и инварианты — через <Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">Debug.Assert</Run>.
                        </TextBlock>
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="15.5"
                                   Margin="0,6,0,0">
                            Формулы контрактов формально доказываются через <Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">wp</Run> в ЛР-2 (<Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">Ctrl+2</Run>), а транзакции из <Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">payment.db</Run> доступны для EOD-аудита циклов в ЛР-3 (<Run FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource TextPrimary}">Ctrl+3</Run>).
                        </TextBlock>
                        <Border Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource BorderBase}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5"
                                Margin="0,8,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                БД SQLite: <Run FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}">payment.db</Run>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Правая рабочая область -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок выбранной операции -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="0,0,0,12"
                    Effect="{StaticResource SurfaceShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectedOperation.Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   FontSize="19"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Design by Contract: проверка предусловий до выполнения и постусловий после завершения операции"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Спецификация контракта"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center"
                            Click="ShowContractButton_Click" />
                </Grid>
            </Border>

            <!-- Живой монитор контракта PRE / POST -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,14"
                    Margin="0,0,0,14"
                    Effect="{StaticResource SurfaceShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Индикатор PRE -->
                    <Border Grid.Column="0"
                            CornerRadius="10"
                            Padding="12,8"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FDE7E9" />
                                <Setter Property="BorderBrush" Value="#F6AEA9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                        <Setter Property="Background" Value="#E6F4EA" />
                                        <Setter Property="BorderBrush" Value="#A8DAB5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRE:"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ОШИБКА" />
                                        <Setter Property="Foreground" Value="#D93025" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                                <Setter Property="Text" Value="ВЫПОЛНЕНО" />
                                                <Setter Property="Foreground" Value="#188038" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Индикатор POST -->
                    <Border Grid.Column="2"
                            CornerRadius="10"
                            Padding="12,8"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0F4F9" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBase}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                        <Setter Property="Background" Value="#E6F4EA" />
                                        <Setter Property="BorderBrush" Value="#A8DAB5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                        <Setter Property="Background" Value="#FDE7E9" />
                                        <Setter Property="BorderBrush" Value="#F6AEA9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="POST:"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ОЖИДАНИЕ" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                                <Setter Property="Text" Value="СОБЛЮДЕНО" />
                                                <Setter Property="Foreground" Value="#188038" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                                <Setter Property="Text" Value="НАРУШЕНО" />
                                                <Setter Property="Foreground" Value="#D93025" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Текст статуса -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding SelectedOperation.StatusMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Рабочая область текущей операции (через DataTemplate из App.xaml) -->
            <ContentControl Grid.Row="2" Content="{Binding SelectedOperation}" />
        </Grid>
    </Grid>
</UserControl>
