<UserControl x:Class="WpEngine.UI.Views.Payment.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="880"
             FontFamily="{StaticResource MainFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="310" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.25*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Левая карточка: параметры перевода и квитанция -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBase}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                Effect="{StaticResource SurfaceShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Параметры перевода"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="15.5"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Счёт списания (From)"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding FromAccount}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource BgRecessed}"
                              BorderBrush="{StaticResource BorderInput}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13"
                              Padding="10,7"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Счёт зачисления (To)"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding ToAccount}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource BgRecessed}"
                              BorderBrush="{StaticResource BorderInput}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13"
                              Padding="10,7"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Сумма перевода (₽)"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="14"
                             Margin="0,0,0,16" />

                    <Button Content="Выполнить перевод"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExecuteCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="20,10"
                            Margin="0,0,0,18" />

                    <Border Background="{StaticResource BgTonal}"
                            BorderBrush="{StaticResource BorderBase}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Результат операции"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       Foreground="{StaticResource BrandPrimary}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding LastResultText}"
                                       FontFamily="{StaticResource CodeFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая колонка: таблица счетов + инвариант + журнал операций -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Карточка счетов и суммы балансов -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource SurfaceShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Счета в системе"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   FontSize="15.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Right"
                                Background="{StaticResource BgPrimaryTonalLight}"
                                BorderBrush="{StaticResource BgPrimaryTonal}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,5">
                            <TextBlock FontSize="12" Foreground="{StaticResource BrandPrimary}" FontWeight="SemiBold">
                                Σ балансов: <Run FontFamily="{StaticResource CodeFont}" Text="{Binding TotalBalanceText, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ListView ItemsSource="{Binding Accounts}"
                              BorderBrush="{StaticResource BorderBase}"
                              BorderThickness="1"
                              Background="{StaticResource BgRecessed}"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="13"
                              MaxHeight="190">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="№ счёта" Width="110" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Владелец" Width="150" DisplayMemberBinding="{Binding Owner}" />
                                <GridViewColumn Header="Баланс" Width="125" DisplayMemberBinding="{Binding Balance, StringFormat={}{0:N2} ₽}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Карточка журнала транзакций -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderBase}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource SurfaceShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Журнал переводов (Journal)"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="15.5"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,10" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding JournalLines}"
                             Background="{StaticResource BgRecessed}"
                             BorderBrush="{StaticResource BorderBase}"
                             BorderThickness="1"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Foreground="{StaticResource TextPrimary}"
                             Padding="6" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
